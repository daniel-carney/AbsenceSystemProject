{
  "manifest_version": 3,
  "name": "Absence Notification System",
  "version": "1.0",
  "description": "Streamlined absence reporting for students and professors.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://*.github.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.github.io/AbsenceSystemProject/*"],
      "js": ["content.js"]
    }
  ]
}